# Vision Engine - Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================================================
# AI ENGINE CONFIGURATION (Multi-Engine Architecture)
# ============================================================================

# PRIMARY ENGINE: Google Gemini 1.5 Flash
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# SECONDARY ENGINE: ZhipuAI GLM-4.7
# Get your API key from: https://open.bigmodel.cn/usercenter/apikeys
GLM_API_KEY=your_glm_api_key_here

# ============================================================================
# SYSTEM CONFIGURATION
# ============================================================================

# Environment: development | staging | production
ENVIRONMENT=development

# ============================================================================
# NOTES
# ============================================================================
# 
# 1. API Keys are OPTIONAL - system will use static fallback if missing
# 2. At least ONE key is recommended for full AI functionality
# 3. Both keys provide automatic failover capability
# 4. GLM-4.7 is used as secondary engine or when volatility is critical
#
# ============================================================================