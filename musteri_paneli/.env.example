# ═══════════════════════════════════════════════════════════════
# YERIMEBAK AI — Ortam Degiskenleri (Production Example)
# Bu dosyayi .env olarak kopyalayip doldurun
# ═══════════════════════════════════════════════════════════════

# ── VERITABANI ──────────────────────────────────────────────────
DATABASE_URL=postgresql://yerimebak:***SILINDI***@localhost:5432/yerimebak_market
POSTGRES_DB=yerimebak_market
POSTGRES_USER=yerimebak
POSTGRES_PASSWORD=***SILINDI***

# ── REDIS ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── GUVENLIK ────────────────────────────────────────────────────
SECRET_KEY=yerimebak_ai_change_me_in_production
ADMIN_SECRET_KEY=yerimebak_admin_2026
DEBUG_MODE=False

# ── SMS OTP ─────────────────────────────────────────────────────
# Provider: dev | twilio | vonage
# dev = SMS gondermez, loga yazar (gelistirme icin)
SMS_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_PHONE_NUMBER=

# ── AI SAGLAYICILAR ─────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PRIMARY_PROVIDER=OPENROUTER
PRIMARY_MODEL=google/gemma-4-31b-it:free
SECONDARY_PROVIDER=OPENROUTER
SECONDARY_MODEL=stepfun/step-3.5-flash:free
FALLBACK_PROVIDER=OPENROUTER
FALLBACK_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=4096

# ── CORS ────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8505,http://localhost:8000

# ── API ─────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000

# ── FRONTEND ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ─── Odeme (PayTR iFrame API) ─────────────────────────────────────
# PayTR Magaza Paneli > Bilgi sayfasindaki degerler. Bos ise odeme baslatilmaz.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# 1 = test modu (gercek para cekilmez), canliya gecerken 0 yapin
PAYTR_TEST_MODE=1
# Odeme sonrasi musterinin donecegi sayfalar
PAYTR_OK_URL=https://yerimebak.com.tr/odeme/sonuc?durum=basarili
PAYTR_FAIL_URL=https://yerimebak.com.tr/odeme/sonuc?durum=basarisiz
# PayTR panelinde "Bildirim URL": https://yerimebak.com.tr/api/v1/payments/paytr/callback
# SADECE gelistirme: PayTR olmadan odemeyi simule eder. CANLIDA ASLA true YAPMAYIN.
PAYMENT_SIMULATION=false
# Hizmet bedeli ilk kurulum degeri (sonra admin panelinden yonetilir)
YERIMEBAK_SERVICE_FEE_TL=6000
