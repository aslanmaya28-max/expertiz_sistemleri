# ═══════════════════════════════════════════════════════════════
# YERIMEBAK — Canli ortam ayarlari (yerimebak.com.tr)
# Bu dosyayi .env olarak kopyalayip doldurun. .env ASLA git'e eklenmez.
# Rehber: docs/CANLIYA_CIKIS.md
# Rastgele anahtar uretmek icin: openssl rand -hex 32
# ═══════════════════════════════════════════════════════════════

# ── VERITABANI / REDIS (docker-compose DATABASE_URL'i bunlardan kurar) ──
POSTGRES_DB=yerimebak
POSTGRES_USER=yerimebak
POSTGRES_PASSWORD=BURAYA_GUCLU_SIFRE
REDIS_PASSWORD=BURAYA_GUCLU_SIFRE

# ── GUVENLIK ────────────────────────────────────────────────────
# Oturum (JWT) ve dosya baglantisi imzalari. En az 32 karakter, rastgele.
SECRET_KEY=BURAYA_openssl_rand_hex_32
# Sadece ilk admin hesabini olusturmak icin; olusturduktan sonra silin.
ADMIN_SECRET_KEY=
DEBUG_MODE=False
JWT_EXPIRE_HOURS=24
CORS_ORIGINS=https://yerimebak.com.tr,https://admin.yerimebak.com.tr

# ── ALAN ADLARI ─────────────────────────────────────────────────
# E-postalardaki baglantilar
PUBLIC_SITE_URL=https://yerimebak.com.tr
ADMIN_SITE_URL=https://admin.yerimebak.com.tr
# Flutter admin paneli derlenirken gomulen API adresi
ADMIN_API_BASE_URL=https://admin.yerimebak.com.tr/api/v1

# ── ODEME (PayTR iFrame API) ────────────────────────────────────
# PayTR Magaza Paneli > Bilgi sayfasindaki degerler.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# 1 = test (gercek para cekilmez). CANLIDA 0 YAPIN.
PAYTR_TEST_MODE=0
PAYTR_OK_URL=https://yerimebak.com.tr/odeme/sonuc?durum=basarili
PAYTR_FAIL_URL=https://yerimebak.com.tr/odeme/sonuc?durum=basarisiz
# PayTR panelinde "Bildirim URL": https://yerimebak.com.tr/api/v1/payments/paytr/callback
# SADECE gelistirme. CANLIDA ASLA true YAPMAYIN (odemesiz kredi yuklenir).
PAYMENT_SIMULATION=false
# Hizmet bedeli ilk kurulum degeri (sonra admin panelinden yonetilir)
YERIMEBAK_SERVICE_FEE_TL=6000
# Yeni uyeye e-posta dogrulaninca verilen ucretsiz analiz kredisi
FREE_CREDITS_ON_REGISTER=3

# ── E-POSTA (SMTP) ──────────────────────────────────────────────
# Sifre sifirlama, e-posta dogrulama, odeme makbuzu ve durum bildirimleri.
# Bos birakilirsa e-posta GONDERILMEZ (sifre sifirlama calismaz).
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=YerimeBak <bildirim@yerimebak.com.tr>
# Yeni talep / onaya gelen rapor e-postalari (virgulle birden fazla)
ADMIN_NOTIFY_EMAIL=

# ── SIRKET BILGILERI (yasal sayfalar ve iletisim; musteri sitesinde calisma aninda okunur) ──
COMPANY_TITLE=
COMPANY_ADDRESS=
COMPANY_TAX_OFFICE=
COMPANY_TAX_NUMBER=
COMPANY_MERSIS=
COMPANY_PHONE=
COMPANY_EMAIL=info@yerimebak.com.tr
COMPANY_KEP=
COMPANY_KVKK_EMAIL=kvkk@yerimebak.com.tr

# ── HATA TAKIBI (istege bagli, sentry.io) ───────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── SUNUCU DISI YEDEK (istege bagli, rclone) ────────────────────
# Ornek (S3 uyumlu: AWS S3, Backblaze B2, Cloudflare R2, Wasabi...):
#   RCLONE_CONFIG_OFFSITE_TYPE=s3
#   RCLONE_CONFIG_OFFSITE_PROVIDER=Other
#   RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=...
#   RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=...
#   RCLONE_CONFIG_OFFSITE_ENDPOINT=https://...
#   OFFSITE_PATH=offsite:yerimebak-yedek
# Etkinlestirme: docker compose --profile offsite up -d
OFFSITE_PATH=
BACKUP_KEEP_DAYS=14

# ── AI SAGLAYICILAR (istege bagli; degerleme kendi motorumuzla calisir) ──
OPENROUTER_API_KEY=
GEMINI_API_KEY=
