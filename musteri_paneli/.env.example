# ═══════════════════════════════════════════════════════════════
# YERIMEBAK — Canli ortam ayarlari (yerimebak.com.tr)
# Bu dosyayi .env olarak kopyalayip doldurun. .env ASLA git'e eklenmez.
# Rehber: docs/CANLIYA_CIKIS.md
# Rastgele anahtar uretmek icin: openssl rand -hex 32
# ═══════════════════════════════════════════════════════════════

# ── VERITABANI / REDIS (docker-compose DATABASE_URL'i bunlardan kurar) ──
POSTGRES_DB=yerimebak
POSTGRES_USER=yerimebak
POSTGRES_PASSWORD=BURAYA_GUCLU_SIFRE
REDIS_PASSWORD=BURAYA_GUCLU_SIFRE

# ── GUVENLIK ────────────────────────────────────────────────────
# Oturum (JWT) ve dosya baglantisi imzalari. En az 32 karakter, rastgele.
SECRET_KEY=BURAYA_openssl_rand_hex_32
# Ilk admin hesabi: uygulama acilisinda bu e-postada hesap yoksa olusturulur.
# Ilk giristen sonra iki satiri da bosaltabilirsiniz (hesap kalir).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# (Istege bagli) /auth/admin/create ucuyla ek admin olusturmak icin; isiniz bitince silin.
ADMIN_SECRET_KEY=
DEBUG_MODE=False
JWT_EXPIRE_HOURS=24
CORS_ORIGINS=https://www.yerimebak.com.tr,https://yerimebak.com.tr,https://admin.yerimebak.com.tr

# ── ALAN ADLARI ─────────────────────────────────────────────────
# E-postalardaki baglantilar
PUBLIC_SITE_URL=https://www.yerimebak.com.tr
ADMIN_SITE_URL=https://admin.yerimebak.com.tr
# Flutter admin paneli derlenirken gomulen API adresi
ADMIN_API_BASE_URL=https://api.yerimebak.com.tr/api/v1

# ── ODEME (PayTR iFrame API) ────────────────────────────────────
# PayTR Magaza Paneli > Bilgi sayfasindaki degerler.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# 1 = test (gercek para cekilmez). CANLIDA 0 YAPIN.
PAYTR_TEST_MODE=0
PAYTR_OK_URL=https://www.yerimebak.com.tr/odeme/sonuc?durum=basarili
PAYTR_FAIL_URL=https://www.yerimebak.com.tr/odeme/sonuc?durum=basarisiz
# PayTR panelinde "Bildirim URL": https://api.yerimebak.com.tr/api/v1/payments/paytr/callback
# SADECE gelistirme. CANLIDA ASLA true YAPMAYIN (odemesiz kredi yuklenir).
PAYMENT_SIMULATION=false
# Hizmet bedeli ilk kurulum degeri (sonra admin panelinden yonetilir)
YERIMEBAK_SERVICE_FEE_TL=6000
# Yeni uyeye e-posta dogrulaninca verilen ucretsiz analiz kredisi
FREE_CREDITS_ON_REGISTER=3

# ── E-POSTA (SMTP) ──────────────────────────────────────────────
# Sifre sifirlama, e-posta dogrulama, odeme makbuzu ve durum bildirimleri.
# Bos birakilirsa e-posta GONDERILMEZ (sifre sifirlama calismaz).
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=YerimeBak <bildirim@yerimebak.com.tr>
# Yeni talep / onaya gelen rapor e-postalari (virgulle birden fazla)
ADMIN_NOTIFY_EMAIL=

# ── SIRKET BILGILERI (yasal sayfalar ve iletisim; musteri sitesinde calisma aninda okunur) ──
COMPANY_TITLE=
COMPANY_ADDRESS=
COMPANY_TAX_OFFICE=
COMPANY_TAX_NUMBER=
COMPANY_MERSIS=
COMPANY_PHONE=
COMPANY_EMAIL=info@yerimebak.com.tr
COMPANY_KEP=
COMPANY_KVKK_EMAIL=kvkk@yerimebak.com.tr

# ── HATA TAKIBI (istege bagli, sentry.io) ───────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── SUNUCU DISI YEDEK (istege bagli, rclone) ────────────────────
# Ornek (S3 uyumlu: AWS S3, Backblaze B2, Cloudflare R2, Wasabi...):
#   RCLONE_CONFIG_OFFSITE_TYPE=s3
#   RCLONE_CONFIG_OFFSITE_PROVIDER=Other
#   RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=...
#   RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=...
#   RCLONE_CONFIG_OFFSITE_ENDPOINT=https://...
#   OFFSITE_PATH=offsite:yerimebak-yedek
# Etkinlestirme: docker compose --profile offsite up -d
OFFSITE_PATH=
BACKUP_KEEP_DAYS=14

# ── KAPASITE (sunucu boyutuna gore; docs/CANLIYA_CIKIS.md "Kapasite") ──
# Asagidaki degerler 4 vCPU / 8 GB sunucu icindir (ornek: Hetzner CPX31 / CCX13).
# 2 vCPU / 4 GB (CX23): WEB_CONCURRENCY=2, APP_MEMORY_LIMIT=2G, PG_SHARED_BUFFERS=512MB, PG_MEMORY_LIMIT=1G
# 8 vCPU / 16 GB:      WEB_CONCURRENCY=8, APP_MEMORY_LIMIT=6G, PG_SHARED_BUFFERS=2GB,  PG_MEMORY_LIMIT=4G
WEB_CONCURRENCY=4
DB_POOL_MAX=20
APP_MEMORY_LIMIT=3G
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=8MB
PG_MEMORY_LIMIT=2G
# Uygulama ici ikinci hiz siniri (IP + adres basina, dakikada). Asil sinir nginx'te.
APP_RATE_LIMIT_PER_MIN=600

# ── APIFY (arabam.com: musterinin ilani + guncel emsaller; boya/degisen/tramer) ──
# off: kapali | mock: ornek veriyle test (ucretsiz, internete cikmaz) | live: gercek Apify
# Kurulum: apify/yerimebak-arac-verisi/README.md
APIFY_MODE=off
# Apify Console > Settings > API & Integrations (yalnizca bu dosyada tutun)
APIFY_TOKEN=
# Apify'daki actor adi: <kullanici-adi>~yerimebak-arac-verisi
APIFY_ACTOR_ID=
# Ayni arac icin emsaller bu sure icinde tekrar cekilmez (saat)
APIFY_REFRESH_HOURS=24
APIFY_YEAR_WINDOW=1
APIFY_MAX_ITEMS=36
APIFY_TIMEOUT_S=600
APIFY_LISTING_TIMEOUT_S=180
APIFY_MEMORY_MB=2048

# ── AI SAGLAYICILAR (istege bagli; degerleme kendi motorumuzla calisir) ──
OPENROUTER_API_KEY=
GEMINI_API_KEY=
